# ── Enable URL Rewriting ─────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Internal code folders are never reachable by URL
    RewriteRule ^(includes|vendor|tests|_archive)/ - [F,L]

    # 0) /index or /index.php (also /dir/index.php) -> the directory itself ("/")
    #    THE_REQUEST is the ORIGINAL request line, so internal rewrites below
    #    can never trigger this redirect again (no loops).
    RewriteCond %{THE_REQUEST} ^(GET|HEAD)\s/+(.*?/)?index(\.php)?(\?\S*)?\sHTTP/ [NC]
    RewriteRule ^ /%2 [R=301,L]

    # 1) Browser GET to any .php URL -> same URL without the extension
    #    (/shop.php -> /shop, /product.php?slug=abc -> /product?slug=abc).
    #    GET/HEAD only: POST requests (forms, PayPal, webhooks, AJAX) keep
    #    hitting the real .php file untouched, so no data is lost in a redirect.
    #    EXCLUDED: AJAX endpoints under /config/ that JS calls with .php.
    RewriteCond %{REQUEST_URI} !(^|/)config/(get-domestic-destinations|get-international-destinations|get-intl-countries|calculate-domestic-shipping|calculate-intl-shipping|calculate-shipping)\.php$ [NC]
    RewriteCond %{THE_REQUEST} ^(GET|HEAD)\s/+([^?\s]+)\.php(\?\S*)?\sHTTP/ [NC]
    RewriteRule ^ /%2 [R=301,L]

    # 2) If the request is for an existing file or directory, do nothing
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3) Internally rewrite extensionless URLs to the actual .php files
    RewriteRule ^index$        index.php        [L,QSA]
    RewriteRule ^shop$         shop.php         [L,QSA]
    RewriteRule ^product$      product.php      [L,QSA]
    RewriteRule ^lookbook$     lookbook.php     [L,QSA]
    RewriteRule ^about$        about.php        [L,QSA]
    RewriteRule ^contact$      contact.php      [L,QSA]
    RewriteRule ^stockist$     stockist.php     [L,QSA]
    RewriteRule ^shipping$     shipping.php     [L,QSA]
    RewriteRule ^legal$        legal.php        [L,QSA]
    RewriteRule ^checkout$     checkout.php     [L,QSA]
    RewriteRule ^login$        login.php        [L,QSA]
    RewriteRule ^register$     register.php     [L,QSA]

    # SEO/GEO: file dinamis yang disajikan dengan nama statis
    RewriteRule ^robots\.txt$  robots.php  [L]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^llms\.txt$    llms.php    [L]

    # 4) Catch-all: any other extensionless URL -> corresponding .php
    #    (also nested paths, e.g. /admin/dashboard -> admin/dashboard.php)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
    RewriteRule ^([a-zA-Z0-9_/-]+)$ $1.php [L,QSA]

    # 5) Alamat tanpa ekstensi yang tidak ada (mis. /asdasd) -> 404.php, yang mengarahkan ke beranda
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
    RewriteRule ^ 404.php [L]
</IfModule>

# ── Security: hide sensitive files ────────────────────
<FilesMatch "\.(env|ini|log|sh|sql|bak|config|json|md|yml|yaml|gitignore|htaccess|htpasswd)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── Block directory listing ───────────────────────────
Options -Indexes

# ── Force UTF-8 ───────────────────────────────────────
AddDefaultCharset UTF-8

# ── Compression ───────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# ── Browser Caching ───────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg     "access plus 1 year"
    ExpiresByType image/jpeg    "access plus 1 year"
    ExpiresByType image/png     "access plus 1 year"
    ExpiresByType image/webp    "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css      "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>